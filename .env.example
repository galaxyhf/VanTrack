# Conexão Neon: pooled para a API; direta para migrações.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full
# Assinatura das sessões. Gere com: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_40_CHARACTERS

# Demonstração: necessários apenas para seed e simulador.
SEED_DEMO=true
DEMO_PASSWORD=REPLACE_WITH_DEVELOPMENT_PASSWORD
SIMULATOR_ENABLED=true
