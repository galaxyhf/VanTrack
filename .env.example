NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Neon pooled runtime URL. Never expose database credentials to NEXT_PUBLIC_*.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_40_CHARACTERS
# Development alternative; production refuses embedded mode.
DATABASE_MODE=embedded
# Absolute path recommended; only one API process may open this directory.
DATABASE_DATA_DIR=/absolute/path/to/VanTrack/.data/vantrack
SEED_DEMO=true
DEMO_PASSWORD=REPLACE_WITH_DEVELOPMENT_PASSWORD
SIMULATOR_ENABLED=true
ROUTING_URL=https://router.project-osrm.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=VanTrack <nao-responda@example.com>
NEXT_PUBLIC_API_URL=http://localhost:4000
